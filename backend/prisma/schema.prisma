generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  INTERESTED
  CONTACTED
  CONVERTED
  LOST
}

enum LeadSource {
  MANUAL
  JUSTDIAL
  WEBSITE
  REFERRAL
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ReminderStatus {
  PENDING
  COMPLETED
}

enum NotificationSource {
  FOLLOW_UP
  REMINDER
}

model Lead {
  id             String         @id @default(cuid())
  name           String
  company        String?
  address        String?
  city           String?
  state          String?
  phone          String?
  email          String?
  requirement    String?
  source         LeadSource     @default(MANUAL)
  status         LeadStatus     @default(NEW)
  externalLeadId String?        @unique
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  followUps      FollowUp[]
  reminders      Reminder[]
  activities     LeadActivity[]
  contact        Contact?
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  company   String?
  address   String?
  leadId    String?  @unique
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FollowUp {
  id        String         @id @default(cuid())
  title     String
  dueAt     DateTime
  status    FollowUpStatus @default(PENDING)
  notes     String?
  result    String?
  leadId    String?
  lead      Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Reminder {
  id          String         @id @default(cuid())
  title       String
  dueAt       DateTime
  status      ReminderStatus @default(PENDING)
  description String?
  leadId      String?
  lead        Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  title     String
  details   String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String             @id @default(cuid())
  source    NotificationSource
  sourceId  String
  sourceKey String             @unique
  title     String
  dueAt     DateTime
  leadId    String?
  leadName  String?
  readAt    DateTime?
  createdAt DateTime           @default(now())
}

model IntegrationEvent {
  id         String   @id @default(cuid())
  provider   String
  externalId String?
  outcome    String
  message    String?
  createdAt  DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resetTokens  PasswordResetToken[]
}

model AuthState {
  id                   String   @id
  registrationClosedAt DateTime?
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId, expiresAt])
}
