generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  INTERESTED
  CONTACTED
  CONVERTED
  LOST
}

enum LeadSource {
  MANUAL
  JUSTDIAL
  WEBSITE
  REFERRAL
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Lead {
  id             String      @id @default(cuid())
  name           String
  company        String?
  address        String?
  phone          String?
  email          String?
  requirement    String?
  source         LeadSource  @default(MANUAL)
  status         LeadStatus  @default(NEW)
  externalLeadId String?     @unique
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  followUps      FollowUp[]
  contact        Contact?
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  company   String?
  address   String?
  leadId    String?  @unique
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FollowUp {
  id        String         @id @default(cuid())
  title     String
  dueAt     DateTime
  status    FollowUpStatus @default(PENDING)
  notes     String?
  leadId    String?
  lead      Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model IntegrationEvent {
  id            String   @id @default(cuid())
  provider      String
  externalId    String?
  outcome       String
  message       String?
  createdAt     DateTime @default(now())
}
